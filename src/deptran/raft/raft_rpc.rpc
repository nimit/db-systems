namespace janus;

struct ServerProps
{
  uint32_t serverId;
  uint64_t term;
  uint64_t lastLogIndex;
  uint64_t lastLogTerm;
  uint64_t leaderCommit;
};

abstract service Raft
{
  defer RequestVote(ServerProps props | uint64_t ret1, bool_t vote_granted);
  defer AppendEntries(MarshallDeputy cmd, uint64_t index, uint64_t term, ServerProps props | uint64_t followerTerm, bool_t followerAppendOK);
  defer EmptyAppendEntries(ServerProps props);
  defer HelloRpc(string req | string res);
}

