namespace janus;

struct ServerState
  {
    uint32_t serverId;
    uint64_t term;
    uint64_t lastLogIndex;
    uint64_t lastLogTerm;
  };

abstract service Raft {
  defer RequestVote(ServerState props |
                    uint64_t ret1,
                    bool_t vote_granted);

  defer AppendEntries(MarshallDeputy cmd |
                      bool_t followerAppendOK);
  defer EmptyAppendEntries(ServerState props);
  defer HelloRpc(string req | string res);
}

