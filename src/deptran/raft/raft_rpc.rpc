namespace janus;

struct ServerProps
{
  uint32_t serverId;
  uint64_t term;
  uint64_t lastLogIndex;
  uint64_t lastLogTerm;
  uint64_t commitIndex;
};

struct Entry {
  MarshallDeputy cmd;
  uint64_t term;
}

abstract service Raft
{
  defer RequestVote(ServerProps props | uint64_t voterTerm, bool_t vote_granted);
  defer AppendEntries(std::vector<Entry> entries, uint64_t prevLogIndex, uint64_t prevLogTerm, ServerProps props | 
                      ServerProps followerProps, bool_t followerAppendOK);
  defer HelloRpc(string req | string res);
}